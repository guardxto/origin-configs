#!/usr/sbin/nft -f
# Accept HTTP and HTTPS only from your proxy's ranges, so nobody can reach the
# origin around it. Everything else on the host is left to your existing rules.
#
# Load:   nft -f origin-lock.nft     (safe to run again: it replaces its own table)
# Check:  nft -c -f origin-lock.nft
# Remove: nft delete table inet origin_lock
#
# The ranges are documentation examples: replace them with your provider's list.

table inet origin_lock
delete table inet origin_lock

table inet origin_lock {
	set proxy4 {
		type ipv4_addr
		flags interval
		elements = { 192.0.2.0/24 }
	}

	set proxy6 {
		type ipv6_addr
		flags interval
		elements = { 2001:db8::/32 }
	}

	chain input {
		type filter hook input priority filter - 1; policy accept;
		tcp dport { 80, 443 } ip saddr @proxy4 accept
		tcp dport { 80, 443 } ip6 saddr @proxy6 accept
		tcp dport { 80, 443 } drop
		udp dport 443 drop    # HTTP/3 straight to the origin
	}
}
